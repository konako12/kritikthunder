# Supabase 프로젝트 설정
# https://supabase.com/dashboard → 프로젝트 → Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# 관리자 전용 (서버에서만 사용, NEXT_PUBLIC_ 없이)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 관리자 이메일 목록 (쉼표로 구분, NEXT_PUBLIC_ 없이)
ADMIN_EMAILS=admin@example.com

# 가입 거절 안내 페이지(/rejected)에 보여줄 문의 이메일 (선택, 서버 전용)
CONTACT_EMAIL=contact@example.com

# Twitch / IGDB API (서버 전용)
TWITCH_CLIENT_ID=your-twitch-client-id
TWITCH_CLIENT_SECRET=your-twitch-client-secret

# DeepL API (서버 전용, NEXT_PUBLIC_ 없이) — 게임 소개 영어 → 한국어 번역
# https://www.deepl.com/your-account/keys · 무료 키는 끝이 ":fx"
DEEPL_API_KEY=your-deepl-api-key

# 기자 가입 승인·거절 안내 메일 (서버 전용) — https://resend.com
# MAIL_FROM은 Resend에서 인증한 도메인 주소여야 함. 비워두면 메일만 보내지 않고 승인·거절은 정상 처리
RESEND_API_KEY=your-resend-api-key
MAIL_FROM=KRITIK <no-reply@your-domain.com>
# 메일 속 로그인 링크에 쓸 사이트 주소 (비우면 관리자가 접속한 주소 사용)
SITE_URL=https://your-domain.com
